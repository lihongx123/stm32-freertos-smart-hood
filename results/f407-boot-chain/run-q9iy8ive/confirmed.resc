using sysbus
mach create "f407-confirmed"
machine LoadPlatformDescription @platforms/cpus/stm32f4.repl
nvic Frequency 168000000
sysbus LoadELF @/home/hello/projects/smart-hood-baseline/SensorTelemetry/build-f407/SensorTelemetryF407.elf
sysbus LoadBinary @/home/hello/projects/smart-hood-baseline/SensorTelemetry/results/f407-boot-chain/run-q9iy8ive/confirmed-record.bin 0x08010000
sysbus LoadELF @/home/hello/projects/smart-hood-baseline/SensorTelemetry/build-boot-f407/HoodBootF407.elf
usart1 CreateFileBackend @/home/hello/projects/smart-hood-baseline/SensorTelemetry/results/f407-boot-chain/run-q9iy8ive/confirmed-uart.log
emulation RunFor "2"
sysbus ReadDoubleWord 0x2000001C
quit
