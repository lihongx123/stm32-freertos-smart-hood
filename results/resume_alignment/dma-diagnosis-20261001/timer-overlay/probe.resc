using sysbus
mach create "smart-hood"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
machine LoadPlatformDescription @renode/uart-dma-diagnostic.repl
nvic Frequency 8000000
timer1 Frequency 8000000
sysbus LoadELF @build/SensorTelemetry.elf
emulation CreateServerSocketTerminal 12346 "sensor" false
connector Connect usart1 sensor
