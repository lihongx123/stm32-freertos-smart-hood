include @/home/hello/projects/smart-hood-baseline/SensorTelemetry/renode/HoodSTM32F407Flash.cs
using sysbus
mach create "sector-9"
machine LoadPlatformDescription @/home/hello/projects/smart-hood-baseline/SensorTelemetry/results/f407-bootloader-update/sector-direct-cg0_p4f2/f407-test-flash.repl
sysbus LoadBinary @/home/hello/projects/smart-hood-baseline/SensorTelemetry/results/f407-bootloader-update/sector-direct-cg0_p4f2/sector-9-before.bin 0x080A0000
sysbus WriteDoubleWord 0x40023C04 0x45670123
