using sysbus
mach create "smart-hood-f407-dma-probe"
machine LoadPlatformDescription @platforms/cpus/stm32f4.repl
machine LoadPlatformDescription @renode/f407-dma-edge.repl
nvic Frequency 168000000
sysbus LoadELF @build-f407/SensorTelemetryF407.elf
usart1 CreateFileBackend @/home/hello/projects/smart-hood-baseline/SensorTelemetry/results/f407-renode-dma-probe.log
emulation RunFor "1"
sysbus ReadDoubleWord 0x40026444
usart1 WriteChar 0x41
usart1 WriteChar 0x42
usart1 WriteChar 0x43
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x40026444
emulation RunFor "2"
usart1 WriteChar 0x0A
emulation RunFor "0.1"
usart1 WriteChar 0x53
usart1 WriteChar 0x2C
usart1 WriteChar 0x35
usart1 WriteChar 0x2C
usart1 WriteChar 0x32
usart1 WriteChar 0x32
usart1 WriteChar 0x2C
usart1 WriteChar 0x34
usart1 WriteChar 0x35
usart1 WriteChar 0x2C
usart1 WriteChar 0x31
usart1 WriteChar 0x30
usart1 WriteChar 0x30
usart1 WriteChar 0x2C
usart1 WriteChar 0x31
usart1 WriteChar 0x30
usart1 WriteChar 0x0A
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x40026444
emulation RunFor "2"
quit
